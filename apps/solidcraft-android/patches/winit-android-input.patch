+    // SolidCraft: report the modifiers held, when they changed.
+    fn update_modifiers<F>(&mut self, meta: MetaState, callback: &mut F)
+    where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        let modifiers = modifiers_from_meta(meta);
+        if modifiers != self.modifiers {
+            self.modifiers = modifiers;
+            let event = event::Event::WindowEvent {
+                window_id: window::WindowId(WindowId),
+                event: event::WindowEvent::ModifiersChanged(modifiers.into()),
+            };
+            callback(event, self.window_target());
+        }
+    }
+
+    // SolidCraft: a mouse event as the cursor's position, the buttons that went down or up since
+    // the last one and the wheel, as winit reports a mouse on the desktop.
+    fn handle_mouse_event<F>(
+        &mut self,
+        motion_event: &MotionEvent<'_>,
+        device_id: event::DeviceId,
+        callback: &mut F,
+    ) where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        let window_id = window::WindowId(WindowId);
+        let pointer = motion_event.pointer_at_index(0);
+        let position = PhysicalPosition { x: pointer.x() as f64, y: pointer.y() as f64 };
+        let action = motion_event.action();
+        let mut send = |event, this: &Self| {
+            callback(event::Event::WindowEvent { window_id, event }, this.window_target())
+        };
+        match action {
+            MotionAction::HoverExit => {
+                send(event::WindowEvent::CursorLeft { device_id }, self);
+                return;
+            },
+            MotionAction::HoverEnter => send(event::WindowEvent::CursorEntered { device_id }, self),
+            _ => {},
+        }
+        send(event::WindowEvent::CursorMoved { device_id, position }, self);
+        if action == MotionAction::Scroll {
+            // Android: positive VSCROLL is the wheel turned away from the user, positive HSCROLL
+            // a scroll to the right; winit: positive moves the content right and down.
+            let v = pointer.axis_value(Axis::Vscroll);
+            let h = pointer.axis_value(Axis::Hscroll);
+            if v != 0.0 || h != 0.0 {
+                let delta = event::MouseScrollDelta::LineDelta(-h, v);
+                let phase = event::TouchPhase::Moved;
+                send(event::WindowEvent::MouseWheel { device_id, delta, phase }, self);
+            }
+            return;
+        }
+        // Every button whose state changed, from the state the event carries (a cancelled
+        // gesture lets go of them all).
+        let now = if action == MotionAction::Cancel {
+            ButtonState(0)
+        } else {
+            motion_event.button_state()
+        };
+        let before = self.mouse_buttons;
+        self.mouse_buttons = now;
+        for (button, was, is) in [
+            (event::MouseButton::Left, before.primary(), now.primary()),
+            (event::MouseButton::Right, before.secondary(), now.secondary()),
+            (event::MouseButton::Middle, before.teriary(), now.teriary()),
+            (event::MouseButton::Back, before.back(), now.back()),
+            (event::MouseButton::Forward, before.forward(), now.forward()),
+        ] {
+            if was != is {
+                let state =
+                    if is { event::ElementState::Pressed } else { event::ElementState::Released };
+                send(event::WindowEvent::MouseInput { device_id, state, button }, self);
+            }
+        }
+    }

+// SolidCraft: the modifier keys an Android meta state holds.
+fn modifiers_from_meta(meta: MetaState) -> crate::keyboard::ModifiersState {
+    use crate::keyboard::ModifiersState;
+    let mut m = ModifiersState::empty();
+    m.set(ModifiersState::SHIFT, meta.shift_on());
+    m.set(ModifiersState::CONTROL, meta.ctrl_on());
+    m.set(ModifiersState::ALT, meta.alt_on());
+    m.set(ModifiersState::SUPER, meta.meta_on());
+    m
 }
